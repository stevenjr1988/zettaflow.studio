{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/.next",
			"!**/.turbo",
			"!**/public",
			"!**/next-env.d.ts",
			"!**/pnpm-lock.yaml",
			"!apps/api/drizzle",
			"!.tools",
			"!.pgdata"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useArrowFunction": "error"
			},
			"style": {
				"useBlockStatements": "error",
				"useConst": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"arrowParentheses": "always"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/tsconfig/*.json"],
			"json": {
				"parser": {
					"allowComments": true
				}
			}
		},
		{
			"includes": [
				"packages/gmsi/icons.json",
				"packages/gmsi/src/icons/Icons.tsx"
			],
			"formatter": {
				"enabled": false
			}
		}
	]
}
